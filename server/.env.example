# Copy this file to .env.development (or .env.production) and fill in real values.

# PostgreSQL connection string used by Prisma.
# Local example: postgresql://postgres:postgres@localhost:5432/entreskillhub
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/entreskillhub

# Port the Express API listens on.
PORT=5000

# Environment: development | production
NODE_ENV=development

# Secret used to sign JWTs - use a long random string in real deployments.
JWT_SECRET=replace_this_with_a_long_random_string

# URL of the frontend, used for CORS.
CLIENT_URL=http://localhost:5173
